{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "task1: build and test",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/homework/answer/task1/scripts/build.ps1",
        "-Test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "task1: run SVG",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/homework/answer/task1/scripts/run.ps1",
        "-Svg",
        "${input:task1Svg}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "task1: build and test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ],
  "inputs": [
    {
      "id": "task1Svg",
      "type": "promptString",
      "description": "SVG 文件或目录：相对 homework/answer/task1，也可填绝对路径",
      "default": "code/svg/basic/test4.svg"
    }
  ]
}
