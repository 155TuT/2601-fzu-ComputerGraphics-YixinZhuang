{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "task1: draw (MinGW GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/homework/answer/task1/bin/draw.exe",
      "args": ["${input:task1Svg}"],
      "cwd": "${workspaceFolder}/homework/answer/task1",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
      "environment": [
        {
          "name": "PATH",
          "value": "C:/msys64/mingw64/bin;${env:PATH}"
        }
      ],
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "task1: build and test"
    }
  ],
  "inputs": [
    {
      "id": "task1Svg",
      "type": "promptString",
      "description": "SVG 文件或目录：相对 homework/answer/task1，也可填绝对路径",
      "default": "code/svg/basic/test4.svg"
    }
  ]
}
