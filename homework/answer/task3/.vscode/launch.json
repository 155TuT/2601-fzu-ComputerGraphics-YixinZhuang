{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "task3: pathtracer (MinGW GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/pathtracer.exe",
      "args": [
        "${input:task3Dae}"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "task3: build"
    }
  ],
  "inputs": [
    {
      "id": "task3Dae",
      "type": "promptString",
      "description": "DAE 文件或目录：相对当前作业文件夹，也可填写绝对路径",
      "default": "code/dae/sky/CBspheres_lambertian.dae"
    }
  ]
}
