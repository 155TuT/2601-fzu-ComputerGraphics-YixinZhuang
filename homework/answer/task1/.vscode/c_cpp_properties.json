{
  "version": 4,
  "configurations": [
    {
      "name": "Windows MinGW task1",
      "compilerPath": "g++.exe",
      "intelliSenseMode": "windows-gcc-x64",
      "cStandard": "c11",
      "cppStandard": "c++11",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/code/src",
        "${workspaceFolder}/code/CGL/include",
        "${workspaceFolder}/code/CGL/deps/glew/include",
        "${workspaceFolder}/code/CGL/deps/glfw/include",
        "${workspaceFolder}/code/CGL/deps/freetype/include"
      ],
      "defines": [
        "GLEW_STATIC"
      ]
    }
  ]
}
